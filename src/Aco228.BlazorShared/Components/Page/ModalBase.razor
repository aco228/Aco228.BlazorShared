@using Aco228.BlazorShared.Services
@using Aco228.Common.Attributes
@using Aco228.Common.Helpers

@if (IsOpen)
{
    <div class="modal-overlay @GetModalClasses()" @onmousedown="OnOverlayMouseDown" @onclick="OnOverlayClicked">
        <div class="modal-panel" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true">
            <div class="modal-header">
                <span class="modal-title">@Title</span>
                <button class="modal-close" type="button" @onclick="Close">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                        <path d="M2 2L10 10M10 2L2 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                @if (IsLoading)
                {
                    <div class="modal-loading-overlay">
                        <div class="modal-loading-spinner"></div>
                    </div>
                }
                <div class="modal-content @(IsLoading ? "modal-content--loading" : "")">
                    @ChildContent
                </div>
                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="modal-error">@ErrorMessage</div>
                }
            </div>
        </div>
    </div>
}

@inherits Aco228.BlazorShared.Code.ComponentImplementation
@code {
    [Parameter] public bool IsOpen
    {
        get;
        set
        {
            if (value == true)
                KeyboardListenerService?.Register(_referenceId, new("Escape"), Close);
            if (value == false)
                KeyboardListenerService?.Remove(_referenceId);
            
            field = value;
        }
    }

    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public bool TopLevel { get; set; } = false;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private string _referenceId { get; set; } = IdHelper.GetId();
    
    [Inject] public IKeyboardListenerService? KeyboardListenerService { get; set; }

    public string GetModalClasses()
    {
        var classes = new List<string>();
        if(TopLevel) classes.Add("modal-overlay-top-level");
        return string.Join(" ", classes);
    }

    private async Task Close()
    {
        IsOpen = false;
        KeyboardListenerService?.Remove(_referenceId);
        await IsOpenChanged.InvokeAsync(false);
    }

    private bool _mouseDownOnOverlay;

    private void OnOverlayMouseDown()
    {
        _mouseDownOnOverlay = true;
    }

    private async Task OnOverlayClicked()
    {
        if (_mouseDownOnOverlay)
            await Close();
        _mouseDownOnOverlay = false;
    }

    public async ValueTask DisposeAsync()
    {
        // TODO release managed resources here
    }

}
